# base

font=JetBrainsMono Nerd Font 11

background-color=#18181bcc
text-color=#ffffff
border-color=#ffffff18

border-size=1
border-radius=14

padding=12
margin=12

width=360
height=120

default-timeout=5000

# text

markup=1
format=<b>%s</b>\n%b

# icons

icons=1
max-icon-size=48

# behavior

anchor=top-right
layer=overlay

sort=-time

# actions

on-button-left=dismiss
on-button-middle=dismiss-all
on-button-right=dismiss

# urgency

[urgency=low]
default-timeout=3000
background-color=#18181bcc
border-color=#ffffff12

[urgency=normal]
default-timeout=5000
background-color=#18181be6
border-color=#ffffff18

[urgency=critical]
default-timeout=0
background-color=#2a1717ee
border-color=#ff5f5f55
text-color=#ffffff